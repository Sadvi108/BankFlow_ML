# Reserved for an optional future LLM fallback. The current /extract endpoint is
# deterministic and does not send receipt contents to Gemini.
GOOGLE_API_KEY=

# Production OCR controls. Defaults shown are suitable for the 512 MB Render
# service. Enable the heavy pass only after measuring it on a larger instance.
OCR_PDF_ZOOM=3.0
OCR_MAX_IMAGE_DIMENSION=2800
OCR_ENABLE_HEAVY_PASS=0

# Supabase persistence (optional)
SUPABASE_URL=
SUPABASE_KEY=
